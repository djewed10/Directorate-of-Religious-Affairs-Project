# Example local environment overrides for switching host IP quickly
#
# To switch the backend/mobile/dev server IP, update the value of
# `HOST_IP` below to the IPv4 address you want to target (for example,
# the IP shown in your screenshot). Leave other lines unchanged.
#
# Examples (commented):
# HOST_IP=127.0.0.1         # loopback (local machine)
# HOST_IP=10.55.124.138     # Wi-Fi (current screenshot)
# HOST_IP=172.19.64.1       # WSL vEthernet (example)

# Active setting: change this line to switch the IP quickly
HOST_IP=10.55.124.138

# Optional ports or endpoints the apps may use
API_PORT=3000
MOBILE_PORT=8081

# Compose a base URL in scripts by using HOST_IP and API_PORT, e.g.
# http://${HOST_IP}:${API_PORT}
